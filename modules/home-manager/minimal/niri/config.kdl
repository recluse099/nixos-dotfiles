// Top level actions
spawn-at-startup "noctalia-shell"
spawn-at-startup "wpaperd"
spawn-at-startup "swaybg" "-i" "/home/recluse/wallpapers/wukong-vs-heaven.jpg";
prefer-no-csd // Niri will draw focus ring and border around windows that agree to omit their client-side decorations.

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"
environment {
  QT_QPA_PLATFORM "wayland"

  // DISPLAY null
}
cursor {
  xcursor-theme "default"
  xcursor-size 32
  hide-after-inactive-ms 1000
}
overview {
  zoom 0.3
  backdrop-color "#2e3440"   // nord dark
  workspace-shadow {
    softness 40
    spread 10
    offset x=0 y=10
    color "#00000050" // semi-transparent black
  }
}
xwayland-satellite {
  path "/run/current-system/sw/bin/xwayland-satellite"
}
/-clipboard {
  disable-primary
}
hotkey-overlay {
  skip-at-startup
  // hide-not-bound
}
input {
  keyboard {
    xkb {
      layout "us"
      options "caps:escape_shifted_capslock"
    }
    repeat-delay 300          // Delay before key repeat starts (ms)
    repeat-rate 50            // Key repeat speed (keys/sec)
  }
  touchpad {
        // off
    tap
    dwt
    natural-scroll
    accel-speed 1
    accel-profile "adaptive"
    scroll-method "two-finger"
  }

  mouse {
    accel-speed 0.8
    accel-profile "adaptive"
      // scroll-method "no-scroll"
    scroll-factor 0.4
  }

  // warp-mouse-to-focus

  // Focus windows and outputs automatically when moving the mouse into them.
  // Setting max-scroll-amount="0%" makes it work only on windows already fully on screen
  // focus-follows-mouse max-scroll-amount="0%"
  workspace-auto-back-and-forth //Switch back to the workspace I came from
  mod-key "Super" //when in a pure niri session
  mod-key-nested "Alt" //when running niri inside some other DE
}

output "eDP-1" {
  // off
  mode "1920x1080"
  scale 1
  transform "normal"
  position x=1280 y=0 //doesn't matter cuz I only have one screen
}

layout {
    // Set gaps around windows in logical pixels.
  gaps 4
  background-color "transparent"
  /-border {
    //on  // Enable borders
    width 2  // Use a thinner width for subtlety
    active-color "#ffc87f"
    inactive-color "rgba(80, 80, 80, 0.3)"  // More transparent for inactive
    urgent-color "#9b0000"
    }
  center-focused-column "never"
  always-center-single-column
  empty-workspace-above-first
  default-column-display "tabbed"
  //background-color "#2e3440" // deep icy gray
  preset-column-widths {
    proportion 0.33333
    proportion 0.5
    proportion 0.66667
      // Fixed sets the width in logical pixels exactly.
      // fixed 1920

  }

  default-column-width { proportion 0.5; } 
  focus-ring {
    // off
    width 3
    active-color "#81a1c1" // nord blue
    inactive-color "#4c566a" // dim gray
    urgent-color "#9b0000" // nord red
    // active-gradient from="#80c8ff" to="#bbddff" angle=45
  }

  shadow {
      on
      softness 25
      spread 4
      offset x=0 y=4
      color "#1b1f2980"   // subtle icy blue-gray
  }

  tab-indicator {
    hide-when-single-tab
    place-within-column
    position "top"
    width 8
    gap 5
    length total-proportion=0.3
    corner-radius 6
    active-color "#bf616a" // nord blue
    inactive-color "#616e88" // dim gray
    urgent-color "#bf616a" // nord red
  }

  insert-hint {
    gradient from="#81a1c180" to="#88c0d080" angle=45 relative-to="workspace-view"
  }
  
  struts {
    top 0
    bottom 1
  }
}

animations {
    // off
    // Slow down all animations by this factor. Values below 1 speed them up instead.
    // slowdown 3.0
}

layer-rule {
    // Find the right namespace by running niri msg layers.
    match namespace="^wpaperd"
    place-within-backdrop true
}
// Block out dunst notifications from screencasts.
layer-rule {
    match namespace="^notifications$"

    block-out-from "screencast"
}

//-------------Window Rules------------------//

window-rule {
  geometry-corner-radius 10
  clip-to-geometry true
}
window-rule {
  match app-id=r#"librewolf$"# title="^Picture-in-Picture$"
  match app-id=r#"floorp$"# title="^Picture-in-Picture$"
  match app-id=r#"QOwnNotes$"# title="^Settings$"

  open-floating true
}
window-rule {
  match title="^Open Files$"
  match app-id="^Xdg-desktop-portal-gtk$"
  open-floating true
  focus-ring {
    off
  }
  shadow {
    off
  }
}

window-rule { // open browsers maximized
  match app-id="floorp"
  match app-id="firefox"
  match app-id="chrome"
  match app-id="zen-twilight"
  match app-id="vesktop"
  match app-id="wasistlos"
  match app-id="signal"
  match app-id="chromium-browser"
  match app-id="librewolf"
  open-maximized true
}
window-rule {
  match app-id="org.pwmt.zathura"
  match app-id="sioyek"
  open-maximized true
  scroll-factor 4
}
window-rule {
  match app-id="com.mitchellh.ghostty"
  scroll-factor 0.5
}
window-rule {
  match app-id="com.mitchellh.ghostty" title="^vim.*" 
  scroll-factor 0.06
}
//------------------Keybinds---------------------//
binds {
  Mod+Shift+Slash { show-hotkey-overlay; }

  // --Application launchers-- 
  Mod+T hotkey-overlay-title="Open a Terminal: kitty" { spawn "kitty"; }
  Mod+D hotkey-overlay-title="Run an Application: fuzzel" { spawn "fuzzel"; }
  Mod+G hotkey-overlay-title="Open terminal: ghostty" { spawn "ghostty"; }
  XF86MonBrightnessDown { spawn-sh "brightnessctl set 4%-"; }
  XF86MonBrightnessUp { spawn-sh "brightnessctl set 4%+"; }

    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "0.05+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "0.05-"; }
    XF86AudioMute        allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioMicMute     allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }

  // You can also move the mouse into the top-left hot corner,
  // or do a four-finger swipe up on a touchpad.
  Mod+A repeat=false { toggle-overview; }
  Mod+Q { close-window; }

  // Focus movement(vim style)
  Mod+Left  { focus-column-left; }
  Mod+Right { focus-column-right; }
  Mod+Down  { focus-workspace-down; }
  Mod+Up    { focus-workspace-up; }

  Mod+H  { focus-column-left; }
  Mod+L  { focus-column-right; }
  Mod+J  { focus-workspace-down; }
  Mod+K  { focus-workspace-up; }
  
  // Move windows(Ctrl + vim keys)
  Mod+Ctrl+Left  { move-column-left; }
  Mod+Ctrl+Down  { move-window-down; }
  Mod+Ctrl+Up    { move-window-up; }
  Mod+Ctrl+Right { move-column-right; }
  Mod+Ctrl+H     { move-column-left; }
  Mod+Ctrl+J     { move-window-down; }
  Mod+Ctrl+K     { move-window-up; }
  Mod+Ctrl+L     { move-column-right; }

  // ─ Workspaces ─ (reclaimed from monitor binds)

  Mod+Shift+J { focus-window-down; }
  Mod+Shift+K { focus-window-up; }
  // mirror options 
  Mod+Shift+Down { focus-window-down; }
  Mod+Shift+Up { focus-window-up; }

  // ─ Move to workspaces ─
  Mod+Ctrl+Shift+J { move-column-to-workspace-down; }
  Mod+Ctrl+Shift+K { move-column-to-workspace-up; }
  Mod+Ctrl+Shift+Down { move-column-to-workspace-down; }
  Mod+Ctrl+Shift+Up { move-column-to-workspace-up; }

  

  Mod+Home { focus-column-first; }
  Mod+End  { focus-column-last; }
  Mod+Ctrl+Home { move-column-to-first; }
  Mod+Ctrl+End  { move-column-to-last; }
   
  Mod+Shift+U         { move-workspace-down; }
  Mod+Shift+I         { move-workspace-up; }

  // ─ Workspace navigation with scroll ─
  Mod+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
  Mod+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
  Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
  Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }

  Mod+1 { focus-workspace 1; }
  Mod+2 { focus-workspace 2; }
  Mod+3 { focus-workspace 3; }
  Mod+4 { focus-workspace 4; }
  Mod+5 { focus-workspace 5; }
  Mod+6 { focus-workspace 6; }
  Mod+7 { focus-workspace 7; }
  Mod+8 { focus-workspace 8; }
  Mod+9 { focus-workspace 9; }
  Mod+Ctrl+1 { move-column-to-workspace 1; }
  Mod+Ctrl+2 { move-column-to-workspace 2; }
  Mod+Ctrl+3 { move-column-to-workspace 3; }
  Mod+Ctrl+4 { move-column-to-workspace 4; }
  Mod+Ctrl+5 { move-column-to-workspace 5; }
  Mod+Ctrl+6 { move-column-to-workspace 6; }
  Mod+Ctrl+7 { move-column-to-workspace 7; }
  Mod+Ctrl+8 { move-column-to-workspace 8; }
  Mod+Ctrl+9 { move-column-to-workspace 9; }

    // Alternatively, there are commands to move just a single window:
    // Mod+Ctrl+1 { move-window-to-workspace 1; }

  // Switches focus between the current and the previous column.
  Mod+Tab { focus-column-right-or-first; }
  Mod+Shift+Tab { focus-column-left-or-last; }
  Alt+Tab { spawn ""; }

  // The following binds move the focused window in and out of a column.
  // If the window is alone, they will consume it into the nearby column to the side.
  // If the window is already in a column, they will expel it out.
  Mod+BracketLeft  { consume-or-expel-window-left; }
  Mod+BracketRight { consume-or-expel-window-right; }

  // Consume one window from the right to the bottom of the focused column.
  Mod+Comma  { consume-window-into-column; }
  // Expel the bottom window from the focused column to the right.
  Mod+Period { expel-window-from-column; }

  Mod+R { switch-preset-column-width; }
  Mod+Shift+R { switch-preset-window-height; }
  Mod+Shift+M { reset-window-height; }
  Mod+M { maximize-column; }
  Mod+F { fullscreen-window; }
  // Expand the focused column to space not taken up by other fully visible columns.
  // Makes the column "fill the rest of the space".
  Mod+Ctrl+F { expand-column-to-available-width; }

  Mod+C { center-column; }

  // Center all fully visible columns on screen.
  Mod+Ctrl+C { center-visible-columns; }

  Mod+Minus { set-column-width "-10%"; }
  Mod+Equal { set-column-width "+10%"; }

  // Finer height adjustments when in column with other windows.
  Mod+Shift+Minus { set-window-height "-10%"; }
  Mod+Shift+Equal { set-window-height "+10%"; }

  // Move the focused window between the floating and the tiling layout.
  Mod+V       { toggle-window-floating; }
  Mod+Shift+V { switch-focus-between-floating-and-tiling; }
  Mod+W { toggle-column-tabbed-display; }

  // Mod+Space       { switch-layout "next"; }
  // Mod+Shift+Space { switch-layout "prev"; }

  Print { screenshot; }
  Ctrl+Print { screenshot-screen; }
  Alt+Print { screenshot-window; }

  Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

  //core system actions
  // Lock(using swaylock)
  Mod+Alt+L hotkey-overlay-title="Lock the Screen: swaylock" { spawn "swaylock"; }
  // Quit niri
  Mod+Shift+E    { quit; }
  Ctrl+Alt+Delete { quit; }
}

