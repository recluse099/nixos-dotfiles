{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palette": {
    "os": "#ACB0BE",
    "pink": "#F5BDE6",
    "lavender": "#B7BDF8",
    "blue": "#8AADF4",
    "white": "#FFFFFF",
    "text": "#494D64"
  },
  "blocks": [
    {
      "alignment": "left",
      "type": "prompt",
      "segments": [
         {
          "type": "session",
          "style": "diamond",
          "background": "p:blue",
          "foreground": "p:text",
          "leading_diamond": "\ue0b6",
          "powerline_symbol": "\ue0b4",
          "template": "{{ .UserName }} "
        },
        {
          "type": "shell",
          "style": "powerline",
          "background": "p:os",
          "foreground": "p:text",
          "powerline_symbol": "",
          "template": " {{ .Name }} "
        },
        {
          "type": "path",
          "style": "powerline",
          "background": "p:pink",
          "foreground": "p:text",
          "powerline_symbol": "",
          "template": " {{ .Path }} ",
          "options": {
            "style": "agnoster_short",
            "home_icon": "~",
            "folder_icon": "..",
            "max_depth": 2,
            "hide_root_location": true
          }
        },
        {
          "type": "git",
          "style": "powerline",
          "background": "p:lavender",
          "foreground": "p:text",
          "powerline_symbol": "",
          "template": " {{ .HEAD }} ",
          "options": {
            "branch_icon": "\ue725 ",
            "commit_icon": "\uf417 ",
            "tag_icon": "\uf412 ",
            "rebase_icon": "\ue728 ",
            "merge_icon": "\ue727 ",
            "cherry_pick_icon": "\ue29b ",
            "revert_icon": "\uf0e2 ",
            "no_commits_icon": "\uf0c3 ",
            "fetch_status": false,
            "fetch_upstream_icon": false
          }
        },
        {
          "type": "nix-shell",
          "style": "powerline",
          "foreground": "p:text",
          "background": "p:os",
          "powerline_symbol": "",
          "template": "{{ if ne .Type \"unknown\" }} nix-shell {{ end }}"
        },
        {
          "type": "executiontime",
          "style": "diamond",
          "trailing_diamond": "",
          "foreground": "p:text",
          "background": "p:blue",
          "template": " <#80393C></> {{ .FormattedMs }} ",
          "options": {
            "threshold": 100,
            "style": "austin",
            "always_enabled": true
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "#21c7c7",
          "template": "\u2570\u2500"
        },
        {
          "type": "status",
          "style": "plain",
          "foreground": "#e0f8ff",
          "foreground_templates": [
            "{{ if gt .Code 0 }}#ef5350{{ end }}"
          ],
          "template": "λ",
          "options": {
            "always_enabled": true
          }
        }
      ]
    }
  ],
  "final_space": true,
  "version": 4
}
